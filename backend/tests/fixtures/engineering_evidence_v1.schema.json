              "type": "number"
            }
          },
          "required": [
            "value",
            "unit"
          ],
          "title": "Quantity",
          "type": "object"
        },
        "SourceLocation": {
          "additionalProperties": false,
          "description": "Position inside an already-identified object; applied after authoritative reread.",
          "properties": {
            "end_line": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "End Line"
            },
            "fragment": {
              "anyOf": [
                {
                  "maxLength": 256,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Fragment"
            },
            "start_line": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Start Line"
            }
          },
          "title": "SourceLocation",
          "type": "object"
        },
        "SourceRef": {
          "additionalProperties": false,
          "description": "Exact reference to one object in its canonical SQL/Git/artifact owner.\n\nThe single shared ref for retrieval hits, context bundles, evidence refs and\nengineering envelopes. A ref identifies; it never carries authority. Git and\nrepository objects may omit workspace_id; ``revision`` is the owner's native\nrevision (commit SHA, record version) and ``content_digest`` is\n``canonical_digest`` of the object content when the owner provides one.",
          "properties": {
            "authority_owner": {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
              "title": "Authority Owner",
              "type": "string"
            },
            "content_digest": {
              "anyOf": [
                {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Content Digest"
            },
            "location": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SourceLocation"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "object_id": {
              "maxLength": 1024,
              "minLength": 1,
              "title": "Object Id",
              "type": "string"
            },
            "object_type": {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
              "title": "Object Type",
              "type": "string"
            },
            "revision": {
              "anyOf": [
                {
                  "maxLength": 256,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Revision"
            },
            "workspace_id": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Workspace Id"
            }
          },
          "required": [
            "authority_owner",
            "object_type",
            "object_id"
          ],
          "title": "SourceRef",
          "type": "object"
        },
        "UncertaintyBound": {
          "additionalProperties": false,
          "properties": {
            "absolute": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Quantity"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "confidence_level": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0.0,
                  "maximum": 1.0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Confidence Level"
            },
            "relative": {
              "anyOf": [
                {
                  "minimum": 0.0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Relative"
            },
            "variable": {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$",
              "title": "Variable",
              "type": "string"
            }
          },
          "required": [
            "variable"
          ],
          "title": "UncertaintyBound",
          "type": "object"
        },
        "ValidityEnvelopeRef": {
          "additionalProperties": false,
          "description": "Where a model/result may be used, how uncertain it is, and its qualification state.\n\nThere is no default status; anything beyond ``candidate`` must cite evidence.\nRecording a status here is metadata, not a qualification decision.",
          "properties": {
            "authority_owner": {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
              "title": "Authority Owner",
              "type": "string"
            },
            "content_digest": {
              "anyOf": [
                {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Content Digest"
            },
            "domain": {
              "default": [],
              "items": {
                "$ref": "#/$defs/DomainBound"
              },
              "maxItems": 32,
              "title": "Domain",
              "type": "array"
            },
            "evidence_refs": {
              "default": [],
              "items": {
                "$ref": "#/$defs/SourceRef"
              },
              "maxItems": 32,
              "title": "Evidence Refs",
              "type": "array"
            },
            "location": {
              "default": null,
              "title": "Location",
              "type": "null"
            },
            "object_id": {
              "maxLength": 1024,
              "minLength": 1,
              "title": "Object Id",
              "type": "string"
            },
            "object_type": {
              "const": "validity_envelope",
              "default": "validity_envelope",
              "title": "Object Type",
              "type": "string"
            },
            "qualification_status": {
              "enum": [
                "unqualified",
                "candidate",
                "calibrated",
                "benchmarked",
                "qualified"
              ],
              "title": "Qualification Status",
              "type": "string"
            },
            "revision": {
              "anyOf": [
                {
                  "maxLength": 256,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Revision"
            },
            "uncertainty": {
              "default": [],
              "items": {
                "$ref": "#/$defs/UncertaintyBound"
              },
              "maxItems": 32,
              "title": "Uncertainty",
              "type": "array"
            },
            "workspace_id": {
              "maxLength": 128,
              "minLength": 1,
              "title": "Workspace Id",
              "type": "string"
            }
          },
          "required": [
            "authority_owner",
            "object_id",
            "workspace_id",
            "qualification_status"
          ],
          "title": "ValidityEnvelopeRef",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "One qualification-ledger entry for a model, property basis or evaluation result.\n\nRequired content (spec 145 P packet): source, organism/strain, conditions,\nunits (through ``Quantity``), uncertainty, calibration basis, validity\ndomain, benchmark evidence and qualification status.",
      "properties": {
        "basis": {
          "$ref": "#/$defs/QualificationBasis",
          "default": {
            "benchmark_refs": [],
            "calibration_refs": [],
            "decided_at": null,
            "decided_by": null,
            "decision_ref": null
          }
        },
        "fidelity": {
          "enum": [
            "screening",
            "reduced_order",
            "steady_state_detailed",
            "dynamic_detailed",
            "field_resolved"
          ],
          "title": "Fidelity",
          "type": "string"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/ProvenanceEntry"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Provenance",
          "type": "array"
        },
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "schema_version": {
          "const": "engineering_evidence.v1",
          "default": "engineering_evidence.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "subject_ref": {
          "discriminator": {
            "mapping": {
              "dynamic_model": "#/$defs/DynamicModelRef",
              "evaluation_result": "#/$defs/EvaluationResultRef",
              "process_model_ir": "#/$defs/ProcessModelIRRef",
              "property_basis": "#/$defs/PropertyBasisRef"
            },
            "propertyName": "object_type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ProcessModelIRRef"
            },
            {
              "$ref": "#/$defs/DynamicModelRef"
            },
            {
              "$ref": "#/$defs/PropertyBasisRef"
            },
            {
              "$ref": "#/$defs/EvaluationResultRef"
            }
          ],
          "title": "Subject Ref"
        },
        "uncertainty": {
          "default": [],
          "items": {
            "$ref": "#/$defs/UncertaintyBound"
          },
          "maxItems": 32,
          "title": "Uncertainty",
          "type": "array"
        },
        "validity": {
          "$ref": "#/$defs/ValidityEnvelopeRef"
        }
      },
      "required": [
        "record_id",
        "subject_ref",
        "fidelity",
        "validity",
        "provenance",
        "recorded_at"
      ],
      "title": "ScientificQualificationRecord",
      "type": "object"
    }
  },
  "version": "engineering_evidence.v1"
}
