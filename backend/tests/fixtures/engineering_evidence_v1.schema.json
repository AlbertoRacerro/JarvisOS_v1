{
  "fidelity_order": [
    "screening",
    "reduced_order",
    "steady_state_detailed",
    "dynamic_detailed",
    "field_resolved"
  ],
  "schemas": {
    "ProvenanceEntry": {
      "$defs": {
        "ConditionValue": {
          "additionalProperties": false,
          "description": "One experimental/operating condition under which a source or model holds.",
          "properties": {
            "value": {
              "$ref": "#/$defs/Quantity"
            },
            "variable": {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$",
              "title": "Variable",
              "type": "string"
            }
          },
          "required": [
            "variable",
            "value"
          ],
          "title": "ConditionValue",
          "type": "object"
        },
        "Quantity": {
          "additionalProperties": false,
          "description": "A finite magnitude in a unit understood by the single Pint owner.\n\nCompound units use Pint syntax (``W/(m**2*K)``); compact exponents such as\n``m2`` are accepted only as whole reviewed tokens (``m2``, ``kg/m3``).",
          "properties": {
            "basis_ref": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SourceRef"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "unit": {
              "maxLength": 64,
              "minLength": 1,
              "title": "Unit",
              "type": "string"
            },
            "value": {
              "title": "Value",
              "type": "number"
            }
          },
          "required": [
            "value",
            "unit"
          ],
          "title": "Quantity",
          "type": "object"
        },
        "SourceLocation": {
          "additionalProperties": false,
          "description": "Position inside an already-identified object; applied after authoritative reread.",
          "properties": {
            "end_line": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "End Line"
            },
            "fragment": {
              "anyOf": [
                {
                  "maxLength": 256,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Fragment"
            },
            "start_line": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Start Line"
            }
          },
          "title": "SourceLocation",
          "type": "object"
        },
        "SourceRef": {
          "additionalProperties": false,
          "description": "Exact reference to one object in its canonical SQL/Git/artifact owner.\n\nThe single shared ref for retrieval hits, context bundles, evidence refs and\nengineering envelopes. A ref identifies; it never carries authority. Git and\nrepository objects may omit workspace_id; ``revision`` is the owner's native\nrevision (commit SHA, record version) and ``content_digest`` is\n``canonical_digest`` of the object content when the owner provides one.",
          "properties": {
            "authority_owner": {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
              "title": "Authority Owner",
              "type": "string"
            },
            "content_digest": {
              "anyOf": [
                {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Content Digest"
            },
            "location": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SourceLocation"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "object_id": {
              "maxLength": 1024,
              "minLength": 1,
              "title": "Object Id",
              "type": "string"
            },
            "object_type": {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
              "title": "Object Type",
              "type": "string"
            },
            "revision": {
              "anyOf": [
                {
                  "maxLength": 256,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Revision"
            },
            "workspace_id": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Workspace Id"
            }
          },
          "required": [
            "authority_owner",
            "object_type",
            "object_id"
          ],
          "title": "SourceRef",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "Where a parameter, correlation, model or dataset came from.\n\nBiology-specific sources name organism/strain; everything cited carries a\nref or citation. ``synthetic_fixture`` marks test/demo data that can never\nsupport a qualification above ``candidate``.",
      "properties": {
        "citation": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citation"
        },
        "conditions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ConditionValue"
          },
          "maxItems": 32,
          "title": "Conditions",
          "type": "array"
        },
        "kind": {
          "enum": [
            "literature",
            "measurement",
            "vendor_datasheet",
            "simulation",
            "expert_estimate",
            "derived",
            "synthetic_fixture"
          ],
          "title": "Kind",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "organism": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organism"
        },
        "source_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "strain": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strain"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ProvenanceEntry",
      "type": "object"
    },
