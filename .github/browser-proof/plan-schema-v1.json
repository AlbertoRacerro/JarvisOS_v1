{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jarvisos.browser-proof-plan.v1",
  "title": "JarvisOS trusted browser proof plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "steps"],
  "properties": {
    "schema": { "const": "jarvisos.browser-proof-plan.v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "fixture": {
      "type": "string",
      "enum": ["none", "model-version-selection"]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "role", "name"],
          "properties": {
            "kind": { "const": "role" },
            "role": { "type": "string", "enum": ["button", "heading", "region", "textbox", "link"] },
            "name": { "type": "string", "maxLength": 300 },
            "exact": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": { "const": "text" },
            "text": { "type": "string", "maxLength": 500 },
            "exact": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "testid"],
          "properties": {
            "kind": { "const": "testid" },
            "testid": { "type": "string", "pattern": "^[A-Za-z0-9:_-]{1,120}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "selector"],
          "properties": {
            "kind": { "const": "css" },
            "selector": { "type": "string", "pattern": "^[A-Za-z0-9_\\-#.:[\\]=\"' >+~()*]+$", "maxLength": 300 }
          }
        }
      ]
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "route"],
          "properties": {
            "op": { "const": "navigate" },
            "route": { "type": "string", "pattern": "^/[A-Za-z0-9_./?=&%:-]*$", "maxLength": 300 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "locator"],
          "properties": {
            "op": { "const": "assert-visible" },
            "locator": { "$ref": "#/$defs/locator" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "locator"],
          "properties": {
            "op": { "const": "click" },
            "locator": { "$ref": "#/$defs/locator" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "locator"],
          "properties": {
            "op": { "const": "open-technical-details" },
            "locator": { "$ref": "#/$defs/locator" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "locator", "attribute", "equals"],
          "properties": {
            "op": { "const": "assert-attribute" },
            "locator": { "$ref": "#/$defs/locator" },
            "attribute": { "type": "string", "enum": ["aria-pressed", "data-provider-egress-state", "value"] },
            "equals": { "type": "string", "maxLength": 300 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "path", "capture"],
          "properties": {
            "op": { "const": "same-origin-get" },
            "path": { "type": "string", "pattern": "^/[A-Za-z0-9_./?=&%:-]*$", "maxLength": 500 },
            "capture": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "fixture"],
          "properties": {
            "op": { "const": "run-fixture" },
            "fixture": { "type": "string", "enum": ["model-version-selection"] },
            "phase": { "type": "string", "enum": ["workspace", "versions"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "name"],
          "properties": {
            "op": { "const": "screenshot" },
            "name": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "forbidden"],
          "properties": {
            "op": { "const": "assert-body-absent" },
            "forbidden": {
              "type": "array",
              "minItems": 1,
              "maxItems": 40,
              "items": { "type": "string", "maxLength": 120 }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "pattern"],
          "properties": {
            "op": { "const": "assert-no-button-label" },
            "pattern": { "type": "string", "maxLength": 300 }
          }
        }
      ]
    }
  }
}
