    {"op":"click","name":"115:open-literature-entry","locator":{"kind":"within","parent":{"kind":"css","selector":"article.final-fusion__record-card:has-text('Reactor search claim for browser proof.')"},"child":{"kind":"role","role":"button","name":"Open in literature","exact":true}}},
