    {"op":"click","name":"115:submit-model-search","locator":{"kind":"role","role":"button","name":"Search","exact":true}},
    {"op":"click","name":"115:open-model-result","locator":{"kind":"within","parent":{"kind":"css","selector":"article.final-fusion__record-card:has-text('Reactor search model')"},"child":{"kind":"role","role":"button","name":"Open in model-dossier","exact":true}}},
