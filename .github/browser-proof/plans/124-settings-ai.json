{
  "schema":"jarvisos.browser-proof-plan.v1",
  "id":"124-settings-ai",
  "fixture":"none",
  "steps":[
    {"op":"navigate","name":"124:settings-ai","route":"/settings/ai"},
    {"op":"same-origin-get","name":"124:provider-settings","path":"/ai/provider-settings","capture":"providerSettings"},
    {"op":"assert-visible","name":"124:settings-heading","locator":{"kind":"role","role":"heading","name":"Settings","exact":true}},
    {"op":"assert-visible","name":"124:catalogue-heading","locator":{"kind":"role","role":"heading","name":"Provider catalogue","exact":true}},
    {"op":"assert-visible","name":"124:provider-list","locator":{"kind":"css","selector":"[data-provider-settings-list]"}},
    {"op":"assert-count","name":"124:provider:fake","locator":{"kind":"css","selector":"[data-provider-id=\"fake\"]"},"equals":1},
    {"op":"assert-count","name":"124:provider:local_ollama","locator":{"kind":"css","selector":"[data-provider-id=\"local_ollama\"]"},"equals":1},
    {"op":"assert-count","name":"124:provider:scaleway","locator":{"kind":"css","selector":"[data-provider-id=\"scaleway\"]"},"equals":1},
    {"op":"assert-count","name":"124:provider:deepseek","locator":{"kind":"css","selector":"[data-provider-id=\"deepseek\"]"},"equals":1},
    {"op":"assert-count","name":"124:provider:glm","locator":{"kind":"css","selector":"[data-provider-id=\"glm\"]"},"equals":1},
    {"op":"assert-count","name":"124:provider:kimi","locator":{"kind":"css","selector":"[data-provider-id=\"kimi\"]"},"equals":1},
    {"op":"capture-json-find","name":"124:server-scaleway","source":"providerSettings","arrayPointer":"/providers","field":"provider_id","equals":"scaleway","capture":"serverScaleway"},
    {"op":"assert-visible","name":"124:credential-heading","locator":{"kind":"within","parent":{"kind":"css","selector":"[data-provider-credential-owner=\"scaleway\"]"},"child":{"kind":"role","role":"heading","name":"Scaleway credential","exact":true}}},
    {"op":"capture-text","name":"124:credential-summary-capture","locator":{"kind":"within","parent":{"kind":"css","selector":"[data-provider-credential-owner=\"scaleway\"]"},"child":{"kind":"css","selector":".settings-card__summary"}},"capture":"credentialSummary"},
    {"op":"open-technical-details","name":"124:credential-disclosure","locator":{"kind":"within","parent":{"kind":"css","selector":"[data-provider-credential-owner=\"scaleway\"]"},"child":{"kind":"css","selector":"details"},"first":true}},
    {"op":"capture-text","name":"124:effective-source-code","locator":{"kind":"within","parent":{"kind":"within","parent":{"kind":"css","selector":"[data-provider-credential-owner=\"scaleway\"]"},"child":{"kind":"css","selector":"details"},"first":true},"child":{"kind":"text","text":"^Effective source code · ","regex":true}},"capture":"effectiveSource","stripPrefix":"Effective source code · "},
    {"op":"capture-text","name":"124:persisted-state-code","locator":{"kind":"within","parent":{"kind":"within","parent":{"kind":"css","selector":"[data-provider-credential-owner=\"scaleway\"]"},"child":{"kind":"css","selector":"details"},"first":true},"child":{"kind":"text","text":"^Persisted state code · ","regex":true}},"capture":"persistedState","stripPrefix":"Persisted state code · "},
    {"op":"assert-value-equals","name":"124:effective-source-server-match","left":{"capture":"effectiveSource"},"right":{"json":{"source":"serverScaleway","pointer":"/credential/effective_source"}}},
    {"op":"assert-value-equals","name":"124:persisted-state-server-match","left":{"capture":"persistedState"},"right":{"json":{"source":"serverScaleway","pointer":"/credential/persisted_state"}}},
    {"op":"map-value","name":"124:map-source-meaning","source":{"capture":"effectiveSource"},"capture":"sourceMeaning","cases":{"not_required":"No credential required","environment":"Environment credential active","secure_persisted":"Securely stored credential active","invalid":"Environment credential invalid","absent":"No effective credential","unknown":"Credential availability unknown"}},
    {"op":"map-value","name":"124:map-persisted-meaning","source":{"capture":"persistedState"},"capture":"persistedMeaning","cases":{"usable":"Stored credential ready","corrupted":"Stored credential damaged","unavailable":"Secure credential store unavailable","not_supported":"Stored credentials not supported","absent":"No stored credential"}},
    {"op":"assert-text-template","name":"124:credential-human-summary","locator":{"kind":"within","parent":{"kind":"css","selector":"[data-provider-credential-owner=\"scaleway\"]"},"child":{"kind":"css","selector":".settings-card__summary"}},"template":"{{capture:sourceMeaning}} · {{capture:persistedMeaning}}."},
    {"op":"assert-visible","name":"124:current-usage","locator":{"kind":"role","role":"heading","name":"Current usage","exact":true}},
    {"op":"capture-attribute","name":"124:credential-input-capture","locator":{"kind":"label","text":"Replace API key","exact":true},"attribute":"value","capture":"credentialInput"},
    {"op":"assert-value-equals","name":"124:credential-input-empty","left":{"capture":"credentialInput"},"right":{"literal":""}},
    {"op":"assert-body-absent","name":"124:no-secret-reference-leak","forbidden":["SCALEWAY_API_KEY","DEEPSEEK_API_KEY","GLM_API_KEY","KIMI_API_KEY","api_key_ref","base_url"]},
    {"op":"assert-no-button-label","name":"124:no-provider-execution-affordance","pattern":"provider.*(test|smoke|run)|(test|smoke|run).*provider"},
    {"op":"assert-all-attributes-in","name":"124:provider-egress-state","locator":{"kind":"css","selector":"[data-provider-egress-state]"},"attribute":"data-provider-egress-state","allowed":["allowed","blocked"],"count":6},
    {"op":"screenshot","name":"124:settings-ai-screenshot","file":"settings-ai"}
  ]
}
