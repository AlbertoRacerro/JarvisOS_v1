{
  "schema": "jarvisos.browser-proof-plan.v1",
  "id": "149-engineering-studies",
  "fixture": "none",
  "steps": [
    {"op":"navigate","name":"149:engineering-studies","route":"/design/studies"},
    {"op":"same-origin-get","name":"149:evaluators-api","path":"/workspaces/bluerev/engineering/evaluators","capture":"evaluators"},
    {"op":"same-origin-get","name":"149:capabilities-api","path":"/workspaces/bluerev/engineering/capabilities","capture":"capabilities"},
    {"op":"capture-json-find","name":"149:pipe-evaluator","source":"evaluators","arrayPointer":"/","field":"evaluator_id","equals":"fluids.pipe_pressure_drop","capture":"pipeEvaluator"},
    {"op":"map-value","name":"149:pipe-evaluator-render-state","source":{"json":{"source":"pipeEvaluator","pointer":"/state"}},"capture":"pipeState","cases":{"available":"Available","unavailable":"Unavailable","not_configured":"Not configured","unknown":"Unavailable"}},
    {"op":"assert-text-template","name":"149:evaluator-state-matches-api","locator":{"kind":"within","parent":{"kind":"css","selector":"[data-evaluator-id=\"fluids.pipe_pressure_drop\"]"},"child":{"kind":"css","selector":".engineering-state"}},"template":"{{capture:pipeState}}"},
    {"op":"capture-json-find","name":"149:hermes-capability","source":"capabilities","arrayPointer":"/","field":"capability_id","equals":"hermes","capture":"hermesCapability"},
    {"op":"assert-json-contract","name":"149:hermes-unavailable-contract","source":"capabilities","pointer":"/0","contract":{"fields":{"capability_id":{"type":"string","equals":"hermes"},"state":{"type":"string","in":["unavailable","not_configured"]},"reason_code":{"type":"nullable-string","minLength":1}}}},
    {"op":"assert-text-template","name":"149:unavailable-capability-and-reason","locator":{"kind":"css","selector":"[data-capability-id=\"hermes\"]"},"template":"hermes · unavailable · {{json:hermesCapability:/reason_code}}"},
    {"op":"assert-visible","name":"149:run-controls","locator":{"kind":"role","role":"heading","name":"Configure and run","exact":true}},
    {"op":"assert-visible","name":"149:operator-surface","locator":{"kind":"testid","testid":"engineering-studies-surface"}},
    {"op":"screenshot","name":"149:engineering-studies-screenshot","file":"engineering-studies"}
  ]
}
